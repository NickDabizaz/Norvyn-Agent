{
  "name": "norvyn",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "norvyn": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:client && tsup src/cli.ts --format esm --out-dir dist",
    "build:client": "vite build --outDir dist/public",
    "generate:protocol": "codex app-server generate-ts --out ./schemas",
    "prepack": "npm run generate:protocol && npm run build",
    "pretest": "npm run generate:protocol && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
