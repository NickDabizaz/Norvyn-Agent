{
  "name": "norvyn",
  "version": "0.1.0",
  "description": "A local-first personal AI assistant for Provider-owned local sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickDabizaz/Norvyn-Agent.git"
  },
  "homepage": "https://nickdabizaz.github.io/Norvyn-Agent/",
  "keywords": [
    "codex",
    "local-first",
    "ai-assistant"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "norvyn": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:client && tsup --config tsup.config.ts",
    "build:client": "vite build --outDir dist/public",
    "check": "npm run verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:protocol": "codex app-server generate-ts --out ./schemas",
    "lint": "eslint src test vite.config.ts tsup.config.ts eslint.config.js",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "prepack": "npm run generate:protocol && npm run build",
    "pretest": "npm run generate:protocol && npm run build",
    "pretypecheck": "npm run generate:protocol",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:cleanup": "tsx test/verify-cleanup.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run lint:styles && npm run typecheck && npm test && npm run test:browser && npm run test:cleanup"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.5",
    "@openai/codex": "0.146.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
